rules_version = '2';
// roeetal.com Firebase rules.
//  - CVEditor: every signed-in user has one private document, vaults/<their uid>. Only that user can read/write it.
//  - Bootkeh live games: bk_games/<gameId> and bk_games/<gameId>/p/<secretKey>.
//      only the storyteller who made a game (owner) can write or delete it; games live at most 13 hours;
//      a player page can be read by anyone who has its secret key (no listing), and only until it expires.
//  Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /bk_games/{gameId} {
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      // the shared state (phase, who is alive, the accusation) is readable by anyone who has the game link, until it expires
      allow get: if resource.data.expiresAt > request.time
        || (request.auth != null && resource.data.owner == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(13, 'h');
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /p/{key} {
        allow get: if resource.data.expiresAt > request.time
          || (request.auth != null && resource.data.owner == request.auth.uid);
        allow list: if request.auth != null && resource.data.owner == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(13, 'h')
          && request.resource.data.size() < 40;
        // the storyteller may change anything but the owner and the expiry;
        // a player (who knows the secret key = document id) may only set their vote and defence, until the page expires
        allow update: if (request.auth != null && resource.data.owner == request.auth.uid
            && request.resource.data.owner == resource.data.owner
            && request.resource.data.expiresAt == resource.data.expiresAt)
          || (resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vote', 'defense']));
        allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      }

      // seat tickets for the one group link: a signed-in (anonymous) player may take a free seat once;
      // only the storyteller and the player who took it can read it (it holds that seat's secret key)
      match /c/{seat} {
        allow get: if request.auth != null
          && (resource.data.owner == request.auth.uid || resource.data.claimedBy == request.auth.uid);
        allow list: if request.auth != null && resource.data.owner == request.auth.uid;
        allow create: if request.auth != null
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(13, 'h')
          && request.resource.data.size() < 8;
        allow update: if request.auth != null
          && ((resource.data.owner == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']))
            || (resource.data.claimedBy == null && resource.data.expiresAt > request.time
               && request.resource.data.claimedBy == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])));
        allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
